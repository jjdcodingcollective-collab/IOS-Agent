# XcodeGen project spec — generated by ios-agent (Tier 1 Step 8).
#
# This file is rewritten on every conversion run. Hand-edits will be lost.
# To customise the project, edit the source-side override files (e.g.
# privacy-overrides.yaml) or extend the emitter at
# converter/xcode_project/emitter.py.
#
# Quickstart (from this directory):
#     xcodegen generate
#     open *.xcodeproj
#
# XcodeGen docs: https://github.com/yonaskolb/XcodeGen
# ADR-0001 mandates XcodeGen as the project-generation tool for MVP.
#
# Placeholders (substituted by the emitter):
#   <APP_NAME>            — display name + target name (alphanumerics + spaces)
#   <APP_NAME_SAFE>       — APP_NAME with spaces stripped, used for filenames
#   <BUNDLE_ID>           — full bundle identifier (com.example.<slug>)
#   <TEAM_ID>             — Apple Developer team id (10 chars) or TODO_TEAMID
#   <DEPLOYMENT_TARGET>   — minimum iOS version (default 15.0)
#   <SWIFT_VERSION>       — Swift toolchain version (default 5.9)
#   <ENTITLEMENTS_BLOCK>  — entitlements: { path: ... } or empty
#   <CAPABILITY_SETTINGS> — per-capability build setting overrides

name: {{APP_NAME_SAFE}}
options:
  deploymentTarget:
    iOS: "{{DEPLOYMENT_TARGET}}"
  createIntermediateGroups: true
  generateEmptyDirectories: true
  groupSortPosition: top

settings:
  base:
    DEVELOPMENT_TEAM: {{TEAM_ID}}
    CODE_SIGN_STYLE: Automatic
    SWIFT_VERSION: "{{SWIFT_VERSION}}"
    IPHONEOS_DEPLOYMENT_TARGET: "{{DEPLOYMENT_TARGET}}"
    TARGETED_DEVICE_FAMILY: "1,2"

targets:
  {{APP_NAME_SAFE}}:
    type: application
    platform: iOS
    sources:
      - path: App
    resources:
      - path: PrivacyInfo.xcprivacy
        optional: true
    info:
      path: App/Info.plist
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: {{BUNDLE_ID}}
        PRODUCT_NAME: "{{APP_NAME}}"
{{CAPABILITY_SETTINGS}}
{{ENTITLEMENTS_BLOCK}}
